rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own profile and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /watchlist/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /history/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // No other collection is accessible
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
